{
  "name": "stock-watcher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply stock-watcher --local",
    "build": "vite build && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "hono": "^4.6.0",
    "lightweight-charts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "4.135.0"
  }
}
